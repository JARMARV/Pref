NODE_ENV="production" 

JWT_SECRET="" #random String to encrypt passwords (should be at least 32 characters long. The longer and more random the better)
JWT_EXPIRES_IN="1d" #time after which a jwt token expires. Making users log in again. examples: 1d, 4h, 30m, 10s

PGHOST=""
PGPORT="" #Port of postgres database
PGUSER="" #username of postgres user
PGPASSWORD="" #password of postgres user
PGDATABASE="pref" #name of database

ORIGIN=""

PORT=""

TEMP_USER_DELETION_INTERVAL="14 days" #time after which unused temp users get deleted